schema_version: 32

http:
  address: 0.0.0.0:80
  session_ttl: 720h

dns:
  bind_hosts:
    - 0.0.0.0
  port: 53
  cache_enabled: true
  cache_size: 4096
  upstream_dns: []
  bootstrap_dns: []
  upstream_mode: load_balance

dhcp:
  enabled: false
  interface_name: ""
  dhcpv4:
    gateway_ip: ""
    subnet_mask: ""
    range_start: ""
    range_end: ""
    lease_duration: 86400
  dhcpv6:
    range_start: ""
    lease_duration: 86400
    ra_slaac_only: false
    ra_allow_slaac: false

filtering:
  filtering_enabled: true
  rewrites: []

user_rules: []

querylog:
  enabled: true
  interval: 1h

statistics:
  enabled: true
  interval: 2160h
  ignored: []

log:
  enabled: true
  file: ""
  max_backups: 0
  max_size: 100
  max_age: 3
  compress: false
  local_time: false
  verbose: false

filters: []
users: []