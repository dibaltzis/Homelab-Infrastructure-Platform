global:
  resolve_timeout: 5m

templates:
  - /etc/alertmanager/templates/discord.tmpl

route:
  receiver: discord-default
  group_by: ['alertname','category']
  group_wait: 10s
  group_interval: 2m
  repeat_interval: 1h

  routes:
{% for name in discord_webhooks.keys() if name != 'default' %}
    - match:
        category: {{ name }}
      receiver: discord-{{ name }}
{% endfor %}

receivers:
{% for name, url in discord_webhooks.items() %}
  - name: discord-{{ name }}
    discord_configs:
      - webhook_url: "{{ url }}"
        send_resolved: true
        title: '{% raw %}{{ template "discord.title" . }}{% endraw %}'
        message: '{% raw %}{{ template "discord.message" . }}{% endraw %}'
{% endfor %}