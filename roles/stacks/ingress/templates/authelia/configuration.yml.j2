server:
  address: tcp://0.0.0.0:9091

theme: dark

log:
  level: info

authentication_backend:
  file:
    path: /config/users.yml

access_control:
  default_policy: one_factor

session:
  name: authelia_session
  secret: "{{ AUTHELIA_SESSION_SECRET }}"
  expiration: 168h
  inactivity: 168h

  cookies:
    - domain: "{{ ingress_domain }}"
      authelia_url: "https://auth.{{ ingress_domain }}"

identity_validation:
  reset_password:
    jwt_secret: "{{ AUTHELIA_JWT_SECRET }}"

storage:
  encryption_key: "{{ AUTHELIA_STORAGE_KEY }}"
  postgres:
    address: tcp://{{ AUTHELIA_POSTGRES_DB.HOST }}
    database: {{ AUTHELIA_POSTGRES_DB.NAME }}
    username: {{ AUTHELIA_POSTGRES_DB.USER }}
    password: {{ AUTHELIA_POSTGRES_DB.PASSWORD }}

notifier:
  filesystem:
    filename: /config/notification.txt