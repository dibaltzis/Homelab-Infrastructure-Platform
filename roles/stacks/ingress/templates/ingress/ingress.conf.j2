server {
    listen 127.0.0.1:8080;

    location = /health {
        access_log off;
        return 200 "ok\n";
    }
}

# plain HTTP → dashboard
server {
    listen 80 default_server;
    server_name _;

    return 301 https://dashboard.{{ ingress_domain }}$request_uri;
}

# default HTTPS → dashboard
server {
    listen 443 ssl;
    server_name _;

    ssl_certificate /etc/nginx/certs/{{ wildcard_certificate.name }}.crt;
    ssl_certificate_key /etc/nginx/certs/{{ wildcard_certificate.name }}.key;

    return 301 https://dashboard.{{ ingress_domain }}$request_uri;
}


# =========================
# Host-based services
# =========================
{% for name, svc in ingress_services.items() %}

server {
    listen 443 ssl;
    server_name {{ svc.host_prefix }}.{{ ingress_domain }};

    ssl_certificate /etc/nginx/certs/{{ wildcard_certificate.name }}.crt;
    ssl_certificate_key /etc/nginx/certs/{{ wildcard_certificate.name }}.key;

    resolver 127.0.0.11 valid=30s;
    {% if svc.requires_auth | default(false) %}
    include /etc/nginx/snippets/authelia.conf;
    {% endif %}


    client_max_body_size 0;

    {% if name == "dashboard" %}
    location = /uptime.txt {
        access_log off;
        proxy_pass http://dashboard:80/uptime.txt;
    }
    {% endif %}

    location / {
        {% if svc.requires_auth | default(false) %}
        auth_request /authelia;
        error_page 401 =302 https://{{ auth_gateway_host }}?rd=$scheme://$http_host$request_uri;
        {% endif %}

        {% if not (svc.access_logging | default(true)) %}
        access_log off;
        {% endif %}
        
        set $upstream {{ svc.upstream }}:{{ svc.port }};
        proxy_pass http://$upstream;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;

    {% if svc.websocket | default(false) %}
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    {% endif %}

    {% if svc.upload | default(false) %}
        proxy_request_buffering off;
        proxy_buffering off;
    {% endif %}
    }
}

{% endfor %}
